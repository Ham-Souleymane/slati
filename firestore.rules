rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    /// True for any signed-in user, including anonymous (guest) sessions.
    function isAuthenticated() {
      return isSignedIn();
    }

    /// True only for non-anonymous (real account) users.
    function isRealUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    /// True when the request is from the document's owner.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// True for users with the Firebase Auth custom claim `admin: true`.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }


    // ── users/{userId} ────────────────────────────────────────
    // Worshippers/imams can read/write their own profile.
    // Only real (non-anonymous) users can write — guests get a doc created
    // server-side (via the app) but should not be able to corrupt it.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isRealUser() && request.auth.uid == userId) || isAdmin();
      allow delete: if false; // soft-delete only via Cloud Functions

      // ── followedMosques (per user) ────────────────────────
      match /followedMosques/{mosqueId} {
        allow read: if isOwner(userId);
        allow write: if isRealUser() && request.auth.uid == userId;
      }

      // ── savedMosques (per user) ────────────────────────────
      match /savedMosques/{mosqueId} {
        allow read: if isOwner(userId);
        allow write: if isRealUser() && request.auth.uid == userId;
      }

      // ── savedPosts (per user) ──────────────────────────────
      match /savedPosts/{postId} {
        allow read: if isOwner(userId);
        allow write: if isRealUser() && request.auth.uid == userId;
      }

      // ── followedImams (per user) ───────────────────────────
      match /followedImams/{imamId} {
        allow read: if isOwner(userId);
        allow write: if isRealUser() && request.auth.uid == userId;
      }
    }


    // ── Imam profiles ─────────────────────────────────────────
    match /imams/{imamId} {
      allow read:  if isAuthenticated() && (request.auth.uid == imamId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == imamId || isAdmin());

      match /notifications/{notifId} {
        allow read, write: if isAuthenticated() && request.auth.uid == imamId;
      }

      match /followers/{userId} {
        allow read:  if isAuthenticated();
        allow write: if isRealUser() && request.auth.uid == userId;
      }
    }


    // ── Mosque documents ──────────────────────────────────────
    match /mosques/{mosqueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated()
        && (resource.data.imamId == request.auth.uid || mosqueId == request.auth.uid || isAdmin());

      match /stats/{document} {
        allow read, write: if isAuthenticated();
      }

      // Nested feed path used by the mosque screen.
      match /posts/{document} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      match /prayerTimes/{document} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // ── followers ───────────────────────────────────────────
      match /followers/{userId} {
        allow read: if isAuthenticated();
        allow write: if isRealUser() && request.auth.uid == userId;
      }
    }


    // ── Root-level prayerTimes (e.g. global/aggregated queries) ─
    match /prayerTimes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ── Root posts collection ─────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.imamId == request.auth.uid
        && (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0)
        && (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0);
      allow update: if isAuthenticated()
        && (
          (resource.data.imamId == request.auth.uid
           && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0)
           && request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0))
          ||
          (isRealUser()
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
           && (request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) + 1
               || request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) - 1
               || request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0))
           && (request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) + 1
               || request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0))
          )
        );
      allow delete: if isAuthenticated()
        && (resource.data.imamId == request.auth.uid || isAdmin());

      // comments sub-collection — real users only, with length validation
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isRealUser()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update: if isRealUser()
          && resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow delete: if isRealUser() && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.imamId == request.auth.uid
          || isAdmin()
        );
      }

      // likes sub-collection — real users only
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isRealUser() && request.auth.uid == userId;
        allow update: if false;
      }
    }


    // ── Reports collection (admin-managed) ───────────────────
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }


    // ── Deny everything else by default ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
